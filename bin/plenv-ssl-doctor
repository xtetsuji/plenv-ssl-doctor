#!/bin/bash

set -eu

if [ -n "${PLENV_DEBUG:-}" ] ; then
    set -x
fi

function select-perl {
    local version
    if ! SELECTED_PERL=$(perl -e 'print $^X') ; then
        echo "Cannot discover the selected Perl. Check PATH and plenv version/which perl." >&2
        return 1
    fi
    if [[ "$SELECTED_PERL" != /* || ! -x "$SELECTED_PERL" ]] ; then
        echo "Selected Perl must be an executable absolute path. Check plenv which perl." >&2
        return 1
    fi
    if ! version=$("$SELECTED_PERL" -e 'printf "%vd", $^V') || [ -z "$version" ] ; then
        echo "Cannot query the selected Perl version. Check plenv which perl." >&2
        return 1
    fi
    echo "Selected Perl: $SELECTED_PERL (version $version)" >&2
}

function select-cpanm {
    local shebang interpreter
    if ! SELECTED_CPANM=$(command -v cpanm) ; then
        echo "Please install cpanm command for the selected Perl: plenv install-cpanm" >&2
        return 1
    fi
    # A plenv shim is a shell dispatcher, not the cpanm Perl script.
    if [[ "$SELECTED_CPANM" == */shims/cpanm ]] ; then
        if ! SELECTED_CPANM=$(plenv which cpanm) ; then
            echo "Cannot resolve the cpanm shim. Run plenv install-cpanm for the selected Perl." >&2
            return 1
        fi
    fi
    if [[ "$SELECTED_CPANM" != /* || ! -f "$SELECTED_CPANM" || ! -r "$SELECTED_CPANM" ]] ; then
        echo "Cannot read an absolute cpanm script path. Check command -v cpanm and plenv which cpanm." >&2
        return 1
    fi
    if ! IFS= read -r shebang < "$SELECTED_CPANM" ; then
        echo "Cannot read the cpanm interpreter. Run plenv install-cpanm for the selected Perl." >&2
        return 1
    fi
    case "$shebang" in
        '#!/usr/bin/env perl') ;;
        '#!'/*)
            interpreter=${shebang#\#!}
            if [[ "$interpreter" == *[[:space:]]* || ! "$interpreter" -ef "$SELECTED_PERL" ]] ; then
                echo "Perl/cpanm mismatch: cpanm does not name the selected Perl." >&2
                echo "Check plenv version, plenv which perl and plenv which cpanm; run plenv install-cpanm for this Perl." >&2
                return 1
            fi
            ;;
        *)
            echo "Cannot verify cpanm as a Perl script. Run plenv install-cpanm for the selected Perl." >&2
            return 1
            ;;
    esac
    echo "Selected cpanm: $SELECTED_CPANM (run with selected Perl)" >&2
}

function run-cpanm {
    local status
    # Pin the interpreter even for an env shebang; never execute a plenv shim.
    if "$SELECTED_PERL" "$SELECTED_CPANM" "$@" ; then
        return 0
    else
        status=$?
    fi
    echo "cpanm failed for $1 (exit $status)." >&2
    build-log-hint
    return "$status"
}

function build-log-hint {
    echo "Review the build.log path printed by cpanm" >&2
    # Print the expression literally to avoid disclosing environment values.
    # shellcheck disable=SC2016
    echo 'or inspect work directories under ${PERL_CPANM_HOME:-$HOME/.cpanm}/work/.' >&2
}

# Reusable, read-only discovery API (Bash 3.2 indexed arrays).
# Requires SELECTED_PERL from select-perl. OPENSSL_CANDIDATE_COUNT records
# share an index in OPENSSL_{PREFIXES,VERSIONS,SOURCES,REASONS}.
# discover-openssl-candidates resets records, returns 0 with candidates, 1
# without candidates, or 2 for an invalid explicit override. Diagnostics use
# stderr; stdout is reserved for command output. No installer runs here.
function add-openssl-candidate {
    local prefix=$1 source=$2 reason=$3 version old library ssl=0 crypto=0
    if [[ "$prefix" != /* || "$prefix" == *[$'\n\r\t']* || ! -d "$prefix" ]] ; then
        echo "Rejected $source: empty or invalid OPENSSL_PREFIX; expected an existing absolute directory." >&2
        return 1
    fi
    prefix=$(cd -P -- "$prefix" && pwd -P) || return 1
    for old in ${OPENSSL_PREFIXES[@]+"${OPENSSL_PREFIXES[@]}"} ; do
        [ "$old" != "$prefix" ] || return 0
    done
    if [ ! -x "$prefix/bin/openssl" ] || ! version=$("$prefix/bin/openssl" version 2>/dev/null) ; then
        echo "Rejected $source prefix '$prefix': bin/openssl version failed." >&2
        return 1
    fi
    if [[ "$version" == *[$'\n\r\t']* || ! "$version" =~ ^OpenSSL[[:space:]]+[0-9]+\.[0-9]+\.[0-9]+[^[:space:]]*([[:space:]].*)?$ ]] ; then
        echo "Rejected $source prefix '$prefix': malformed OpenSSL version output." >&2
        return 1
    fi
    if [ ! -f "$prefix/include/openssl/ssl.h" ] || [ ! -r "$prefix/include/openssl/ssl.h" ] ; then
        echo "Rejected $source prefix '$prefix': missing readable include/openssl/ssl.h." >&2
        return 1
    fi
    # Accept conventional Unix shared/static libraries, including versioned ELF
    # sonames and lib64 layouts. Existence alone (or a dangling link) is insufficient.
    for library in "$prefix"/lib/libssl.{a,dylib,so,so.*} "$prefix"/lib64/libssl.{a,dylib,so,so.*} ; do
        if [ -f "$library" ] && [ -r "$library" ] && [ -s "$library" ] ; then ssl=1; fi
    done
    for library in "$prefix"/lib/libcrypto.{a,dylib,so,so.*} "$prefix"/lib64/libcrypto.{a,dylib,so,so.*} ; do
        if [ -f "$library" ] && [ -r "$library" ] && [ -s "$library" ] ; then crypto=1; fi
    done
    if [ "$ssl" -ne 1 ] || [ "$crypto" -ne 1 ] ; then
        echo "Rejected $source prefix '$prefix': missing readable, nonempty ssl and crypto libraries in lib or lib64." >&2
        return 1
    fi
    OPENSSL_PREFIXES+=("$prefix")
    OPENSSL_VERSIONS+=("$version")
    OPENSSL_SOURCES+=("$source")
    OPENSSL_REASONS+=("$reason")
    OPENSSL_CANDIDATE_COUNT=$((OPENSSL_CANDIDATE_COUNT + 1))
}

function discover-openssl-candidates {
    local prefix formula
    OPENSSL_CANDIDATE_COUNT=0
    RESOLVED_OPENSSL_PREFIX='' SELECTED_OPENSSL_VERSION=''
    SELECTED_OPENSSL_SOURCE='' SELECTED_OPENSSL_REASON='' SELECTED_OPENSSL_INDEX=''
    OPENSSL_PREFIXES=() OPENSSL_VERSIONS=() OPENSSL_SOURCES=() OPENSSL_REASONS=()
    if [ "${CLI_OPENSSL_PREFIX_SET:-0}" -eq 1 ] ; then
        add-openssl-candidate "$CLI_OPENSSL_PREFIX" cli 'explicit --openssl-prefix' || return 2
    elif [ "${OPENSSL_PREFIX+x}" = x ] ; then
        add-openssl-candidate "$OPENSSL_PREFIX" environment 'explicit OPENSSL_PREFIX' || return 2
    else
        if command -v brew >/dev/null 2>&1 ; then
            for formula in openssl@3 openssl ; do
                if prefix=$(brew --prefix "$formula" 2>/dev/null) && [ -n "$prefix" ] ; then
                    add-openssl-candidate "$prefix" "homebrew:$formula" 'first valid automatic candidate in discovery order' || :
                fi
            done
        fi
        # Query only an already available module: future offline check callers
        # can reuse discovery without cpanm, downloads, or module installation.
        if "$SELECTED_PERL" -MCrypt::OpenSSL::Guess -e 1 >/dev/null 2>&1 ; then
            if prefix=$("$SELECTED_PERL" -MCrypt::OpenSSL::Guess -e 'print find_openssl_prefix()' 2>/dev/null) ; then
                add-openssl-candidate "$prefix" guess 'first valid automatic candidate in discovery order' || :
            else
                echo "Cannot query Crypt::OpenSSL::Guess with the selected Perl." >&2
            fi
        fi
    fi
    [ "${OPENSSL_CANDIDATE_COUNT:-0}" -gt 0 ]
}

# select-openssl-candidate returns 0 with selected fields, 1 without records.
# Compatibility-policy extension point: inspect all candidate records here,
# preserve explicit selections, and set the selected index/reason. Discovery
# deliberately makes no assertion about Net::SSLeay/OpenSSL compatibility.
function select-openssl-candidate {
    [ "${OPENSSL_CANDIDATE_COUNT:-0}" -gt 0 ] || return 1
    SELECTED_OPENSSL_INDEX=0
    RESOLVED_OPENSSL_PREFIX=${OPENSSL_PREFIXES[$SELECTED_OPENSSL_INDEX]}
    SELECTED_OPENSSL_VERSION=${OPENSSL_VERSIONS[$SELECTED_OPENSSL_INDEX]}
    SELECTED_OPENSSL_SOURCE=${OPENSSL_SOURCES[$SELECTED_OPENSSL_INDEX]}
    SELECTED_OPENSSL_REASON=${OPENSSL_REASONS[$SELECTED_OPENSSL_INDEX]}
}

function prepare-openssl-selection {
    local status
    if discover-openssl-candidates ; then
        :
    else
        status=$?
        [ "$status" -ne 2 ] || return 2
        # Installation-only prerequisite setup. Valid explicit/Homebrew results
        # and an existing Guess module never require installing Guess.
        if ! "$SELECTED_PERL" -MCrypt::OpenSSL::Guess -e 1 >/dev/null 2>&1 ; then
            echo "=== install Crypt::OpenSSL::Guess ==="
            run-cpanm Crypt::OpenSSL::Guess || return $?
            discover-openssl-candidates || {
                echo "No valid OpenSSL candidate found after installing Crypt::OpenSSL::Guess." >&2
                return 1
            }
        else
            echo "No valid OpenSSL candidate found. Install OpenSSL development files or use --openssl-prefix PATH." >&2
            return 1
        fi
    fi
    select-openssl-candidate || return $?
    echo "Selected OpenSSL: $RESOLVED_OPENSSL_PREFIX" >&2
    echo "OpenSSL version: $SELECTED_OPENSSL_VERSION" >&2
    echo "OpenSSL source: $SELECTED_OPENSSL_SOURCE; reason: $SELECTED_OPENSSL_REASON" >&2
}

function install-net-ssleay {
    # Explicit input errors remain errors even if the module is already present.
    if [ "${CLI_OPENSSL_PREFIX_SET:-0}" -eq 1 ] || [ "${OPENSSL_PREFIX+x}" = x ] ; then
        discover-openssl-candidates || return $?
    fi
    if "$SELECTED_PERL" -MNet::SSLeay -e 1 >/dev/null 2>&1 ; then
        echo "Already installed Net::SSLeay?"
        echo "If you want to reinstall Net::SSLeay,"
        echo "then type \"cpanm --uninstall Net::SSLeay\" for uninstall."
        return
    fi

    select-cpanm || return $?

    prepare-openssl-selection || return $?

    echo "=== install Net::SSLeay by OPENSSL_PREFIX=$RESOLVED_OPENSSL_PREFIX ==="
    OPENSSL_PREFIX="$RESOLVED_OPENSSL_PREFIX" \
        run-cpanm Net::SSLeay || return $?

    if ! "$SELECTED_PERL" -MNet::SSLeay -e 1 ; then
        echo "Net::SSLeay installation could not be verified with the selected Perl. Inspect cpanm build.log and the load error above." >&2
        build-log-hint
        return 1
    fi

    echo "Congratulations! Net::SSLeay is installed!"
}

function io-socket-ssl-status {
    # Exit 2 only when the module itself is missing; other failures must not
    # fall through to installation. VERSION handles Perl version formats.
    "$SELECTED_PERL" <<'PERL'
use strict;
use warnings;
unless (eval { require IO::Socket::SSL; 1 }) {
    my $error = $@;
    if ($error =~ /\ACan't locate IO\/Socket\/SSL\.pm in \@INC\b/) {
        warn "IO::Socket::SSL is not installed.\n";
        exit 2;
    }
    warn "Failed to load IO::Socket::SSL: $error";
    exit 1;
}
unless (eval { IO::Socket::SSL->VERSION('1.42'); 1 }) {
    warn "IO::Socket::SSL does not satisfy the minimum version 1.42: $@";
    warn "Please upgrade with: cpanm IO::Socket::SSL\n";
    exit 1;
}
PERL
}

function install-io-socket-ssl {
    local status
    if io-socket-ssl-status ; then
        echo "IO::Socket::SSL is already installed (version 1.42 or newer)."
        return 0
    else
        status=$?
    fi
    if [ "$status" -ne 2 ] ; then
        return 1
    fi

    select-cpanm || return $?

    echo "=== install IO::Socket::SSL ==="
    run-cpanm IO::Socket::SSL || return $?
    if ! io-socket-ssl-status ; then
        echo "IO::Socket::SSL installation could not be verified. Inspect cpanm build.log and the load error above." >&2
        build-log-hint
        return 1
    fi
}

function check-io-socket-ssl {
    if "$SELECTED_PERL" -MIO::Socket::SSL -e 1 >/dev/null 2>&1 ; then
        # shellcheck disable=SC2016
        if ! "$SELECTED_PERL" -MIO::Socket::SSL -le 'print $IO::Socket::SSL::VERSION' ; then
            echo "Cannot query IO::Socket::SSL version with the selected Perl." >&2
            return 1
        fi
    else
        echo "It seems that IO::Socket::SSL is not installed" >&2
        return 1
    fi
}

function main {
    local arg='' option_seen=0
    CLI_OPENSSL_PREFIX_SET=0
    # Options may precede or follow the command; exactly one value is consumed.
    # Empty overrides are errors, and repeated options use the last value.
    while [ "$#" -gt 0 ] ; do
        case "$1" in
            --openssl-prefix)
                if [ "$#" -lt 2 ] || [[ "$2" == --* ]] || [ -z "$2" ] ; then
                    echo "--openssl-prefix requires a nonempty PATH argument." >&2
                    return 2
                fi
                CLI_OPENSSL_PREFIX=$2 CLI_OPENSSL_PREFIX_SET=1 option_seen=1
                shift 2
                ;;
            --*) echo "Unknown option: $1" >&2; return 2 ;;
            *)
                if [ -n "$arg" ] ; then
                    echo "Unexpected argument: $1" >&2
                    return 2
                fi
                arg=$1
                shift
                ;;
        esac
    done
    if [ "$option_seen" -eq 1 ] && [ "$arg" != install-net-ssleay ] ; then
        echo "--openssl-prefix is supported only with install-net-ssleay." >&2
        return 2
    fi
    case "$arg" in
        install-net-ssleay)
            select-perl || return $?
            install-net-ssleay "$@"
            ;;
        install-io-socket-ssl)
            select-perl || return $?
            install-io-socket-ssl "$@"
            ;;
        check-io-socket-ssl)
            select-perl || return $?
            check-io-socket-ssl "$@"
            ;;
        ""|*)
            echo "Usage:"
            echo "  plenv ssl-doctor [install-net-ssleay|install-io-socket-ssl|check-io-socket-ssl] [--openssl-prefix PATH]"
            ;;
    esac
}

if [ "${BASH_SOURCE[0]}" = "$0" ] ; then
    main "$@"
fi
